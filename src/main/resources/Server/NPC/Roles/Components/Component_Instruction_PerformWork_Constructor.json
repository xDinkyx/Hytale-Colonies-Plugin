{
  "$Comment": "PerformWork loop body for the Constructor -- seeks to the target block and breaks it. Build-block placement is driven by ECS state flags within the same PerformWork sub-state.",
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "HytaleColonies.Instruction.Colonist.StateBody",
  "Content": {
    "Sensor": { "Type": "Any" },
    "Instructions": [
      {
        "$Comment": "Dropped items nearby -- seek and pick up before working the next block.",
        "Sensor": { "Type": "DroppedItem", "Range": 5.0 },
        "BodyMotion": { "Type": "Seek", "StopDistance": 0.5, "SlowDownDistance": 1.5, "RelativeSpeed": 0.9 },
        "Actions": [
          { "Type": "LogDebug", "Message": "PerformWork: picking up dropped item.", "Category": "CONSTRUCTOR_JOB", "Level": "FINE" },
          { "Type": "PickUpItem", "Range": 1.5, "StorageTarget": "Inventory" }
        ]
      },
      {
        "Continue": true,
        "Sensor": { "Type": "ReadPosition", "Slot": "NavTarget", "Range": 200.0, "MinRange": 1.5 },
        "BodyMotion": { "Type": "Seek", "StopDistance": 1.0, "SlowDownDistance": 2.0, "RelativeSpeed": 0.8 }
      },
      {
        "Sensor": { "Type": "JobTarget", "Range": 2.5 },
        "ActionsBlocking": true,
        "Actions": [
          { "Type": "PlayAnimation", "Slot": "Status", "Animation": "Interact" },
          { "Type": "LogDebug", "Message": "PerformWork: working block.", "Category": "CONSTRUCTOR_JOB", "Level": "FINE" },
          { "Type": "EquipBestTool" },
          { "Type": "HarvestBlock", "DamageScale": 0.1 },
          { "Type": "Timeout", "Delay": [0.5, 0.5] }
        ]
      }
    ]
  }
}
