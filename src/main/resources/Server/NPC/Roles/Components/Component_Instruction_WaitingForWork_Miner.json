{
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "HytaleColonies.Instruction.Colonist.WaitingForWork",
  "Content": {
    "$Comment": "WaitingForWork -- miner: wander at workstation, check for tools, scan for mine block.",
    "Sensor": { "Type": "Any" },
    "Instructions": [
      {
        "Continue": true,
        "Sensor": { "Type": "Any" },
        "BodyMotion": {
          "Type": "Sequence",
          "Looped": true,
          "Motions": [
            { "Type": "Timer", "Time": [4, 6], "Motion": { "Type": "WanderInCircle", "Radius": 5, "MaxHeadingChange": 0.4 } },
            { "Type": "Timer", "Time": [1, 2], "Motion": { "Type": "Nothing" } }
          ]
        }
      },
      {
        "$Comment": "No pickaxe -- confused particle + wait.",
        "Sensor": { "Type": "Not", "Sensor": { "Type": "Self", "Filters": [{ "Type": "Inventory", "Items": ["Tool_Pickaxe_*"], "CountRange": [1, 999] }] } },
        "ActionsBlocking": true,
        "Actions": [
          { "Type": "LogDebug", "Message": "WaitingForWork: missing pickaxe -- showing confused particle.", "Category": "MINER_JOB", "Level": "FINE" },
          { "Type": "SpawnParticles", "ParticleSystem": "Question_Subtle", "Offset": [0, 2.1, 0] },
          { "Type": "Timeout", "Delay": [3, 3] }
        ]
      },
      {
        "$Comment": "No shovel -- confused particle + wait.",
        "Sensor": { "Type": "Not", "Sensor": { "Type": "Self", "Filters": [{ "Type": "Inventory", "Items": ["Tool_Shovel_*"], "CountRange": [1, 999] }] } },
        "ActionsBlocking": true,
        "Actions": [
          { "Type": "LogDebug", "Message": "WaitingForWork: missing shovel -- showing confused particle.", "Category": "MINER_JOB", "Level": "FINE" },
          { "Type": "SpawnParticles", "ParticleSystem": "Question_Subtle", "Offset": [0, 2.1, 0] },
          { "Type": "Timeout", "Delay": [3, 3] }
        ]
      },
      {
        "$Comment": "Has both tools (passed Not-checks above) -- check for a queued ore vein block first (higher priority).",
        "Continue": true,
        "Sensor": { "Type": "Any" },
        "Actions": [
          { "Type": "LogDebug", "Message": "WaitingForWork: checking for queued ore vein block.", "Category": "MINER_JOB", "Level": "FINE" },
          { "Type": "SeekNextOreVeinBlock" }
        ]
      },
      {
        "$Comment": "Ore vein target claimed -- travel to it.",
        "Sensor": { "Type": "JobTargetExists" },
        "Actions": [
          { "Type": "LogDebug", "Message": "WaitingForWork: ore vein target found -> TravelingToWorkSite.", "Category": "MINER_JOB", "Level": "FINE" },
          { "Type": "SetEcsJobState", "JobState": "TravelingToWorkSite" }
        ]
      },
      {
        "$Comment": "No ore vein -- try the active mine segment prefab next.",
        "Continue": true,
        "Sensor": { "Type": "Any" },
        "Actions": [
          { "Type": "LogDebug", "Message": "WaitingForWork: checking active mine segment.", "Category": "MINER_JOB", "Level": "FINE" },
          { "Type": "SeekNextMineSegmentBlock" }
        ]
      },
      {
        "$Comment": "Segment block claimed -- travel to it.",
        "Sensor": { "Type": "JobTargetExists" },
        "Actions": [
          { "Type": "LogDebug", "Message": "WaitingForWork: mine segment target found -> TravelingToWorkSite.", "Category": "MINER_JOB", "Level": "FINE" },
          { "Type": "SetEcsJobState", "JobState": "TravelingToWorkSite" }
        ]
      }
    ]
  }
}
