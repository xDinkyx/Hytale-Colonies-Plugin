$Common = "../Common.ui";

Group {
    Anchor: (Width: 560, Height: 580);
    Background: #141c26;
    LayoutMode: Top;
    Padding: (Full: 16);

    Label #StationTitle {
        Text: "Workstation";
        Anchor: (Height: 36);
        Style: (FontSize: 20, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
    }

    Label #StationStats {
        Text: "";
        Anchor: (Height: 20);
        Style: (FontSize: 12, TextColor: #7a8fa8, HorizontalAlignment: Center);
    }

    Group { Anchor: (Height: 1); Background: #2b3542; }
    Group { Anchor: (Height: 10); }

    Group {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $Common.@DefaultScrollbarStyle;

        Label #EmptyLabel {
            Text: "No colonists assigned.";
            Anchor: (Height: 40);
            Style: (FontSize: 13, TextColor: #4a5e72, HorizontalAlignment: Center);
        }

        Group { Anchor: (Height: 6); }

        Group #Row0 {
            LayoutMode: Left;
            Anchor: (Height: 44);
            Label #Row0Name { Text: ""; Anchor: (Width: 170, Height: 44); Style: (FontSize: 13, TextColor: #e8eef5, VerticalAlignment: Center); }
            Label #Row0State { Text: ""; Anchor: (Width: 120, Height: 44); Style: (FontSize: 11, TextColor: #5a9fcf, VerticalAlignment: Center); }
            TextButton #Row0Inspect {
                Text: "Inspect";
                Anchor: (Width: 76, Height: 36);
                Style: (Default: (Background: #2b3542, LabelStyle: (FontSize: 12, TextColor: #96a9be, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (Background: #3b4552, LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Group { Anchor: (Width: 4); }
            TextButton #Row0Fire {
                Text: "Fire";
                Anchor: (Width: 60, Height: 36);
                Style: (Default: (Background: #3a1a1a, LabelStyle: (FontSize: 12, TextColor: #c06060, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (Background: #541e1e, LabelStyle: (FontSize: 12, TextColor: #f08080, HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
        }
        Group { Anchor: (Height: 4); }

