            Text: "Recall All";
            Anchor: (Width: 130, Height: 44);
            Style: (Default: (Background: #1a2e1a, LabelStyle: (FontSize: 13, TextColor: #5aaa60, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (Background: #22401e, LabelStyle: (FontSize: 13, TextColor: #80cc80, HorizontalAlignment: Center, VerticalAlignment: Center)));
        }

        Group { Anchor: (Width: 236); }

        TextButton #CloseButton {
            Text: "Close";
            Anchor: (Width: 90, Height: 44);
            Style: (Default: (Background: #2b3542, LabelStyle: (FontSize: 13, TextColor: #96a9be, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (Background: #3b4552, LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center)));
