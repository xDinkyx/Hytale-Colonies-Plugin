{
  "$Comment": "PerformWork body for the Constructor. Uses State sensors to branch between the Harvesting sub-state (clearing blocks) and the Constructing sub-state (placing prefab blocks).",
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "HytaleColonies.Instruction.Colonist.StateBody",
  "Content": {
    "Sensor": { "Type": "Any" },
    "Instructions": [
      {
        "$Comment": "Harvesting -- seek to clearing target and break it.",
        "Sensor": { "Type": "State", "State": ".Harvesting" },
        "Instructions": [
          {
            "$Comment": "Dropped items nearby -- pick up before working the next block.",
            "Sensor": { "Type": "DroppedItem", "Range": 5.0 },
            "BodyMotion": { "Type": "Seek", "StopDistance": 0.5, "SlowDownDistance": 1.5, "RelativeSpeed": 0.9 },
            "Actions": [
              { "Type": "LogDebug", "Message": "Harvesting: picking up dropped item.", "Category": "CONSTRUCTOR_JOB", "Level": "FINE" },
              { "Type": "PickUpItem", "Range": 1.5, "StorageTarget": "Inventory" }
            ]
          },
          {
            "Continue": true,
            "Sensor": { "Type": "ReadPosition", "Slot": "NavTarget", "Range": 200.0, "MinRange": 1.5 },
            "BodyMotion": { "Type": "Seek", "StopDistance": 1.0, "SlowDownDistance": 2.0, "RelativeSpeed": 0.8 }
          },
          {
            "Sensor": { "Type": "JobTarget", "Range": 2.5 },
            "ActionsBlocking": true,
            "Actions": [
              { "Type": "PlayAnimation", "Slot": "Status", "Animation": "Interact" },
              { "Type": "LogDebug", "Message": "Harvesting: breaking block.", "Category": "CONSTRUCTOR_JOB", "Level": "FINE" },
              { "Type": "EquipBestTool" },
              { "Type": "HarvestBlock", "DamageScale": 0.1 },
              { "Type": "Timeout", "Delay": [0.5, 0.5] }
            ]
          },
          {
            "$Comment": "Block is now air -- notify ECS that the clearing target was broken.",
            "Continue": true,
            "Sensor": { "Type": "JobTargetBroken" },
            "Actions": [
              {
                "Type": "LogDebug",
                "Message": "Harvesting: block broken -- notifying ECS.",
                "Category": "CONSTRUCTOR_JOB",
                "Level": "FINE"
              },
              { "Type": "NotifyBlockBroken" }
            ]
          }
        ]
      },
      {
        "$Comment": "Constructing -- navigate to build target and place the prefab block.",
        "Sensor": { "Type": "State", "State": ".Constructing" },
        "Instructions": [
          {
            "Continue": true,
            "Sensor": { "Type": "ReadPosition", "Slot": "NavTarget", "Range": 200.0, "MinRange": 1.0 },
            "BodyMotion": { "Type": "Seek", "StopDistance": 0.5, "SlowDownDistance": 4.0, "RelativeSpeed": 1.0 }
          },
          {
            "Sensor": { "Type": "JobTarget", "Range": 2.5 },
            "ActionsBlocking": true,
            "Actions": [
              { "Type": "PlayAnimation", "Slot": "Status", "Animation": "Interact" },
              { "Type": "LogDebug", "Message": "Constructing: placing block.", "Category": "CONSTRUCTOR_JOB", "Level": "FINE" },
              { "Type": "PlaceConstructionBlock" },
              { "Type": "Timeout", "Delay": [0.6, 0.8] }
            ]
          }
        ]
      }
    ]
  }
}
