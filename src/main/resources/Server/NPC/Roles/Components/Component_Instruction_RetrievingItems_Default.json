{
  "$Comment": "RetrievingItems default body -- finds the nearby container, seeks to it, retrieves required items. Stays blocked with wander until the container is stocked; retries automatically each tick.",
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "HytaleColonies.Instruction.Colonist.StateBody",
  "Content": {
    "Sensor": { "Type": "Any" },
    "Instructions": [
      {
        "Continue": true,
        "Sensor": { "Type": "Any" },
        "Actions": [
          { "Type": "FindDeliveryContainer" }
        ]
      },
      {
        "Continue": true,
        "Sensor": { "Type": "ReadPosition", "Slot": "NavTarget", "Range": 200.0, "MinRange": 1.0 },
        "BodyMotion": { "Type": "Seek", "StopDistance": 0.5, "SlowDownDistance": 4, "RelativeSpeed": 1.0 }
      },
      {
        "$Comment": "At container: try to take needed items. Returns false (stays blocked) when not all items are there; wanders nearby while waiting for restock.",
        "Sensor": { "Type": "JobTarget", "Range": 3.0 },
        "ActionsBlocking": true,
        "Actions": [
          { "Type": "RetrieveJobItems" }
        ],
        "BodyMotion": {
          "Type": "Sequence",
          "Looped": true,
          "Motions": [
            { "Type": "Timer", "Time": [3, 5], "Motion": { "Type": "WanderInCircle", "Radius": 3, "MaxHeadingChange": 0.4 } },
            { "Type": "Timer", "Time": [1, 2], "Motion": { "Type": "Nothing" } }
          ]
        }
      },
      {
        "$Comment": "RetrieveJobItems returned true -- all items in inventory, proceed to work.",
        "Sensor": { "Type": "Any" },
        "Actions": [
          { "Type": "SetEcsJobState", "JobState": "TravelingToWorkSite" }
        ]
      }
    ]
  }
}

