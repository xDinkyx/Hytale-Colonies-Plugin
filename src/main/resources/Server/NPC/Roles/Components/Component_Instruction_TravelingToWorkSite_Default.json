{
  "$Comment": "TravelingToWorkSite body -- seek to the job target and transition to PerformWork on arrival.",
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "HytaleColonies.Instruction.Colonist.StateBody",
  "Content": {
    "Sensor": { "Type": "Any" },
    "Instructions": [
      {
        "$Comment": "Clear work animation and set nav target on state entry.",
        "Continue": true,
        "Sensor": { "Type": "Any", "Once": true },
        "Actions": [ { "Type": "PlayAnimation", "Slot": "Status" }, { "Type": "NavigateTo", "Target": "JobTarget" } ]
      },
      {
        "Continue": true,
        "Sensor": { "Type": "ReadPosition", "Slot": "NavTarget", "Range": 200.0, "MinRange": 1.0 },
        "BodyMotion": { "Type": "Seek", "StopDistance": 0.5, "SlowDownDistance": 4, "RelativeSpeed": 1.0 }
      },
      {
        "Sensor": { "Type": "JobTarget", "Range": 2.5 },
        "Actions": [
          { "Type": "SetEcsJobState", "JobState": "PerformWork" }
        ]
      }
    ]
  }
}
